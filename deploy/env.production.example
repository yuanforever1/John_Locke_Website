# ============================================================
# 生产环境 .env 模板
# 用法：复制到 backend/.env 并填写真实值
#   cp deploy/env.production.example backend/.env
# 注意：backend/.env 已被 .gitignore 忽略，切勿把真实密钥提交到 git。
# ============================================================

# 用长随机串替换。可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 生产环境必须为 False
DJANGO_DEBUG=False

# 允许访问的主机名/域名（逗号分隔）。换成你的域名（和公网 IP，可选）
DJANGO_ALLOWED_HOSTS=john-locke.ccwu.cc

# 前端正式来源。同源部署（前端与 API 在同一域名下）时，
# CORS 其实不会被触发；此处仍按正式域名填写以防跨源调用。
# 上线 HTTPS 后请改成 https://
CORS_ALLOWED_ORIGINS=https://john-locke.ccwu.cc

# 手稿识别接口（OpenRouter，OpenAI 兼容）
# 到服务器上填写你自己的真实 OpenRouter API Key（sk-or-...），不要写进 git
RECOGNITION_API_KEY=
RECOGNITION_BASE_URL=https://openrouter.ai/api/v1
# 默认快模型；改成 google/gemini-3.1-pro-preview 可切到高质量 pro 模型
RECOGNITION_MODEL=google/gemini-3.8-flash
RECOGNITION_TIMEOUT=120
# 以下两项可选：用于 OpenRouter 配额归属与来源展示
RECOGNITION_SITE_URL=https://john-locke.ccwu.cc
RECOGNITION_SITE_NAME=John Locke Manuscript Platform
