# ============================================================
# 生产环境 .env 模板
# 用法：复制到 backend/.env 并填写真实值
#   cp deploy/env.production.example backend/.env
# 注意：backend/.env 已被 .gitignore 忽略，切勿把真实密钥提交到 git。
# ============================================================

# 用长随机串替换。可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 生产环境必须为 False
DJANGO_DEBUG=False

# 允许访问的主机名/域名（逗号分隔）。换成你的域名（和公网 IP，可选）
DJANGO_ALLOWED_HOSTS=john-locke.ccwu.cc

# 前端正式来源。同源部署（前端与 API 在同一域名下）时，
# CORS 其实不会被触发；此处仍按正式域名填写以防跨源调用。
# 上线 HTTPS 后请改成 https://
CORS_ALLOWED_ORIGINS=https://john-locke.ccwu.cc

# Agnes AI 手稿识别接口（OpenAI 兼容）
# 到服务器上填写你自己的真实密钥，不要写进 git
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=gpt-4o
AGNES_TIMEOUT=120
