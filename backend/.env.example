# 复制本文件为 .env 并按需填写。

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 前端跨域来源
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 手稿识别接口（OpenRouter，OpenAI 兼容）
# 在此填写你的 OpenRouter API Key（sk-or-...）
RECOGNITION_API_KEY=
RECOGNITION_BASE_URL=https://openrouter.ai/api/v1
# 默认快模型；改成 google/gemini-3.1-pro-preview 可切到高质量 pro 模型
RECOGNITION_MODEL=google/gemini-3.8-flash
RECOGNITION_TIMEOUT=120
# 以下两项可选：用于 OpenRouter 配额归属与来源展示
RECOGNITION_SITE_URL=http://localhost:5173
RECOGNITION_SITE_NAME=John Locke Manuscript Platform
